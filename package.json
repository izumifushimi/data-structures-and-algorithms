{
  "name": "data-structures-and-algorithms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "node scripts/check-content.mjs",
    "import:notes": "python3 scripts/import-notes.py",
    "check:animations": "node scripts/check-animations.mjs",
    "check:problems": "node scripts/check-problems.mjs",
    "build:oj": "vite build --config tools/oj-runtime/vite.config.js && node scripts/sync-oj-runtime.mjs",
    "check:oj": "node tools/oj-runtime/smoke-test.mjs && node tools/oj-runtime/termination-test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/theme-one-dark": "^6.1.3",
    "codemirror": "^6.0.2",
    "diff": "^8.0.2",
    "highlight.js": "^11.11.1",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@runno/wasi": "^0.10.3",
    "vite": "^7.2.2"
  },
  "description": "数据结构与算法：基于语雀笔记的数据结构与算法学习网站，含原码、讲解、动画和浏览器 C++ OJ。",
  "engines": {
    "node": ">=22.12.0"
  }
}
